# ── Server ──────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ────────────────────────────────────────
# Replace with your Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/ray-of-hope?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=30d

# ── Client Origin (for CORS) ─────────────────────────────
CLIENT_URL=http://localhost:3000

# ── AI Provider (optional – plug in later) ───────────────
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AI...
